---
# The Canadian ecosystem directory. Records live in data/initiatives.yaml and
# are grouped by their first category, so each organization appears once.
# Server-rendered: no filtering, no search, no JavaScript.
pagination:
  data: catalog.site.languages
  size: 1
  alias: lang
  addAllPagesToCollections: true
permalink: "/{{ lang }}/canada/"
layout: base.njk
eleventyComputed:
  pageTitle: "{{ 'nav_canada' | t(lang) }}"
  description: "{{ 'canada_lead' | t(lang) | safe }}"
---
<h1>{{ "canada_title" | t(lang) }}</h1>
<p class="hero__lead">{{ "canada_lead" | t(lang) }}</p>
<p class="card__meta">{{ catalog.initiatives.length }} {{ "canada_count" | t(lang) }}</p>

<section class="section">
  <h2>{{ "canada_why_heading" | t(lang) }}</h2>
  <p>{{ "canada_why_ownership" | t(lang) }}</p>
  <p>{{ "canada_why_global" | t(lang) }}</p>
</section>

<section class="section">
  <h2>{{ "canada_categories_heading" | t(lang) }}</h2>
  <ul class="plain">
    {% for group in catalog.initiativeGroups %}
    <li><a href="#{{ group.id }}">{{ ("canada_category_" + group.id) | t(lang) }}</a> ({{ group.initiatives.length }})</li>
    {% endfor %}
  </ul>
</section>

{% for group in catalog.initiativeGroups %}
<section class="section">
  <h2 id="{{ group.id }}">{{ ("canada_category_" + group.id) | t(lang) }}</h2>
  <ul class="card-grid">
    {% for entry in group.initiatives %}
    <li>
      <article class="card">
        <p class="card__meta">{{ ("canada_type_" + entry.organization_type) | t(lang) }} · {{ ("canada_connection_" + entry.canadian_connection.type) | t(lang) }}</p>
        <h3 class="card__title">{{ entry.name }}</h3>
        <p class="card__body">{{ entry.summary | loc(lang) }}</p>
        {% if entry.categories.length > 1 %}
        <p class="cluster">
          {% for category in entry.categories %}{% if not loop.first %}<span class="badge">{{ ("canada_category_" + category) | t(lang) }}</span>{% endif %}{% endfor %}
        </p>
        {% endif %}
        <ul class="plain">
          {% for contribution in entry.contributions %}
          <li>{{ contribution.description | loc(lang) }}</li>
          {% endfor %}
        </ul>
        {% if entry.featured %}
        <p class="card__meta"><strong>{{ "canada_featured" | t(lang) }}{{ "colon" | t(lang) }}</strong> {{ entry.featured_rationale | loc(lang) }}</p>
        {% endif %}
        <details>
          <summary>{{ "canada_sources" | t(lang) }}</summary>
          <ul>
            {% for url in entry.sourceLinks %}<li><a href="{{ url }}">{{ url }}</a></li>{% endfor %}
          </ul>
        </details>
        <p class="card__footer">
          <a href="{{ entry.website }}">{{ "canada_website" | t(lang) }}</a>
        </p>
        {% if not entry.verified %}<p class="card__meta">{{ "not_reviewed" | t(lang) }}</p>{% endif %}
      </article>
    </li>
    {% endfor %}
  </ul>
</section>
{% endfor %}

<section class="section">
  <h2>{{ "canada_how_heading" | t(lang) }}</h2>
  <ul class="plain">
    {% for item in "canada_how_body" | t(lang) %}<li>{{ item }}</li>{% endfor %}
  </ul>
  <p><a href="{{ catalog.site.repo }}/blob/main/docs/ECOSYSTEM-EDITORIAL-POLICY.md">{{ "canada_policy_link" | t(lang) }}</a></p>
  <p>{{ "canada_corrections" | t(lang) }}</p>
  <p class="report"><a href="{{ catalog.site.repo }}/issues">{{ "footer_contribute" | t(lang) }}</a></p>
</section>
