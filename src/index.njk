---
permalink: /
eleventyExcludeFromCollections: true
---
<!doctype html>
<html lang="en-CA" data-base="{{ '/' | htmlBaseUrl }}">
<head>
  <meta charset="utf-8">
  <!-- Redirects to a stored or browser-matched language before paint, so
       returning visitors and visitors with en/fr browsers skip this page.
       No cookies: same-origin, inline, localStorage only (see js/lang.js
       for the click-time save). Visitors with no en/fr match, or with JS
       off, see the choice below instead. data-base carries the built
       path prefix (e.g. "/DiDay/"), the same one HtmlBasePlugin applies
       to every href on the site, since a runtime redirect target can't
       be rewritten by that build-time HTML transform. -->
  <script>(function(){
    "use strict";
    var v;
    try { v = localStorage.getItem("lang"); } catch (e) {}
    if (v !== "en" && v !== "fr") {
      var langs = navigator.languages || [navigator.language || ""];
      for (var i = 0; i < langs.length; i++) {
        var p = String(langs[i]).slice(0, 2).toLowerCase();
        if (p === "en" || p === "fr") { v = p; break; }
      }
    }
    if (v === "en" || v === "fr") {
      var base = document.documentElement.getAttribute("data-base") || "/";
      location.replace(base + v + "/");
    }
  })();</script>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <title>{{ catalog.site.name.en }} | {{ catalog.site.name.fr }}</title>
  <meta name="description" content="{{ catalog.site.tagline.en }} {{ catalog.site.tagline.fr }}">
  <!-- Both languages sit on this page, and each language has its own page:
       the alternates point there. Open Graph and rel="me" match the rest of
       the site (see _includes/base.njk). -->
  <link rel="canonical" href="{{ catalog.site.url }}/">
  <link rel="alternate" hreflang="en-CA" href="{{ catalog.site.url }}/en/">
  <link rel="alternate" hreflang="fr-CA" href="{{ catalog.site.url }}/fr/">
  <link rel="alternate" hreflang="x-default" href="{{ catalog.site.url }}/">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ catalog.site.name.en }}">
  <meta property="og:locale" content="en_CA">
  <meta property="og:locale:alternate" content="fr_CA">
  <meta property="og:url" content="{{ catalog.site.url }}/">
  <meta property="og:title" content="{{ catalog.site.name.en }}">
  <meta property="og:description" content="{{ catalog.site.tagline.en }} {{ catalog.site.tagline.fr }}">
  <meta property="og:image" content="{{ catalog.site.url }}/img/diday-en.jpg">
  <meta property="og:image:type" content="image/jpeg">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="633">
  <meta property="og:image:alt" content="{{ 'og_image_alt' | t('en') }}">
  {% if catalog.site.mastodon %}<meta name="fediverse:creator" content="{{ catalog.site.mastodon }}">{% endif %}
  {% if catalog.site.mastodon %}<link rel="me" href="{{ catalog.site.mastodon | mastodonUrl }}">{% endif %}
  {% if catalog.site.gander %}<link rel="me" href="{{ catalog.site.gander | ganderUrl }}">{% endif %}
  {% if catalog.site.gander_group %}<link rel="me" href="{{ catalog.site.gander_group }}">{% endif %}
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <main class="wrap splash">
    <div>
      <h1>{{ catalog.site.name.en }}</h1>
      <p>{{ catalog.site.tagline.en }}</p>
      <p><a class="button" href="/en/" data-lang="en">English</a></p>
    </div>
    <div lang="fr-CA">
      <h1>{{ catalog.site.name.fr }}</h1>
      <p>{{ catalog.site.tagline.fr }}</p>
      <p><a class="button" href="/fr/" data-lang="fr">Français</a></p>
    </div>
  </main>
  <script src="/js/lang.js" defer></script>
</body>
</html>
